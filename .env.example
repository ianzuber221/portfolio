# Powers the AI chat assistant. Without it, the chat uses a curated fallback.
OPENAI_API_KEY=your-openai-key

# Optional: model override for the chat (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional: max /api/chat requests per IP per minute (default 12).
CHAT_RATE_LIMIT=12

# Optional: raises the GitHub API rate limit used to list projects.
# A classic token with public repo read access is plenty.
GITHUB_TOKEN=

# Optional: absolute site URL used for SEO/OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=https://ianzuber.dev
